  },
  "homepage": "https://github.com/NikitaVirachev/nikivils-grimoire-contracts#readme",
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  }
}
