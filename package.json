{
  "name": "@nikivils/grimoire-contracts",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "description": "Shared API contracts for Nikivils Grimoire",
  "files": [
    "dist"
  ],
